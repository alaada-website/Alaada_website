{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ww.alaada.com"
        }
      ],
      "destination": "https://www.alaada.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://alaada-workspaces.onrender.com/api/:path*"
    },
    {
      "source": "/workspace",
      "destination": "/workspace.html"
    },
    {
      "source": "/workspaces",
      "destination": "/workspace.html"
    }
  ]
}
